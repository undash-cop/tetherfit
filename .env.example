# TetherFit – Environment Variables
# Copy to .env and fill with Undash-Cop credentials.
# Never commit real secrets.

# ── App ──────────────────────────────────────────────
APP_NAME=TetherFit
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── External PostgreSQL (Undash-Cop) ─────────────────
# Prefer a dedicated database, e.g. tetherfit
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/tetherfit

# ── External Redis (Undash-Cop) ──────────────────────
REDIS_URL=redis://host:6379/0
CELERY_BROKER_URL=redis://host:6379/1
CELERY_RESULT_BACKEND=redis://host:6379/2

# ── Keycloak (Undash-Cop) ────────────────────────────
# On UDC VPS: KEYCLOAK_SERVER_URL=http://keycloak:8080 (from global.env)
KEYCLOAK_SERVER_URL=https://keycloak.example.com
KEYCLOAK_REALM=undash
KEYCLOAK_CLIENT_ID=tetherfit-web
KEYCLOAK_AUDIENCE=tetherfit-api
# Public JWT iss (required on UDC — tokens use HTTPS issuer, JWKS uses KEYCLOAK_SERVER_URL)
# UDC_JWT_ISSUER=https://secure.undash-cop.com/realms/undash
# Optional: if API is a confidential client
# KEYCLOAK_CLIENT_SECRET=

# Frontend Vite (also set in apps/web/.env / Netlify build env)
VITE_KEYCLOAK_URL=https://keycloak.example.com
VITE_KEYCLOAK_REALM=undash
VITE_KEYCLOAK_CLIENT_ID=tetherfit-web
VITE_API_URL=http://localhost:8000
# Production example: VITE_API_URL=https://api.tetherfit.undash-cop.com
# CORS_ORIGINS must include the Netlify origin(s)

# ── Cloudflare R2 ────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tetherfit
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# ── Razorpay (Phase 2) ───────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── SMTP email notifications (Phase 6) ───────────────
# When SMTP_HOST is set, email notifications use SMTP; otherwise noop.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ── AI (Phase 3) ─────────────────────────────────────
# noop | openai | openai_compatible | ollama | gemini | claude
AI_PROVIDER=noop
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

MARKETPLACE_PUBLIC_BASE_URL=

# ── Web Push (Phase 5) ───────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
